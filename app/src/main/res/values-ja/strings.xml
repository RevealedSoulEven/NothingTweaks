    <string name="pref_battery_cap_title">充電制限</string>
    <string name="pref_battery_cap_summary">バッテリー寿命を延ばすため、設定した残量に達したら充電を停止します</string>
    <string name="pref_battery_cap_level_title">充電停止レベル</string>
