    <!-- Battery & Charging -->
    <string name="cat_battery">电池与充电</string>
    <string name="pref_battery_cap_title">充电上限</string>
    <string name="pref_battery_cap_summary">达到设定电量时停止充电以延长电池寿命</string>
    <string name="pref_battery_cap_level_title">停止充电于</string>
    <string name="pref_battery_cap_level_summary">在选定的百分比暂停充电</string>
    <string name="pref_battery_cap_notify_title">充电暂停通知</string>
    <string name="pref_battery_cap_notify_summary">达到限制停止充电时显示通知</string>
    <string name="pref_battery_cap_note_title">为什么将充电限制在 80%？</string>
    <string name="pref_battery_cap_note_summary">电池研究表明，当电芯处于高电压（&gt;80% / 4.2V+）和高温状态下时，锂离子电池的老化会显著加速。限制充电上限可减轻正极的电化学应力并延缓 SEI 膜的增厚，从而使电池的整体循环寿命延长一倍以上。</string>

